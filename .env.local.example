# Copy to .env.local and fill in (Supabase Dashboard -> Project Settings -> API).
# Test project: the shared ytk.tech project. PROD: the Quotation PROD project.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY — bypasses Row Level Security. Used by /api/draw and /api/config.
# Never commit it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
